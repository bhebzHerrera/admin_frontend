# Laravel API base URL — must be HTTPS (enable SSL in Laragon: Menu > Apache > SSL > Enabled).
VITE_API_URL=https://arc-car-rental-backend.test/api

# Live monitoring refresh interval in milliseconds.
VITE_MONITORING_POLL_MS=15000

# Sign out automatically after this many minutes without activity.
VITE_IDLE_TIMEOUT_MINUTES=30
